{
  "name": "ems-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "node --env-file=.env --import tsx scripts/seed.ts",
    "db:generate-types": "node --env-file=.env node_modules/.bin/kysely-codegen --out-file src/db/types.ts --camel-case",
    "setup:local": "bash scripts/setup-local.sh",
    "setup:local:reset": "bash scripts/setup-local.sh --reset",
    "deploy:railway": "bash scripts/deploy-railway.sh"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "jsonwebtoken": "^9.0.3",
    "kysely": "^0.29.4",
    "next": "16.2.12",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "kysely-codegen": "^0.20.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}